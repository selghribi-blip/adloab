# انسخ هذا الملف إلى .env واملأ القيم ثم:  set -a; source .env; set +a
# ملف .env مستبعد في .gitignore — لا تُودِعه في Git أبدًا.

# ---------- Telegram ----------
# 1) افتح محادثة مع @BotFather في Telegram ← /newbot ← انسخ التوكن
TELEGRAM_BOT_TOKEN=
# 2) أرسل أي رسالة لبوتك، ثم افتح محادثة مع @userinfobot لتعرف رقمك
#    أو شغّل:  python -m app.cli telegram-id
TELEGRAM_CHAT_ID=

# ---------- Webhook عام (اختياري) ----------
# أمثلة: ntfy.sh/موضوعك ، Slack hook ، Discord webhook
ALERT_WEBHOOK_URL=

# ---------- قاعدة البيانات (اختياري) ----------
# PostgreSQL معطّل افتراضيًا (يُستخدم SQLite)
# ADLOAB_DB_URL=postgresql://user:pass@host:5432/adloab

# ---------- نطاقات إضافية للسماح بالفحص (اختياري) ----------
# ADLOAB_EXTRA_DOMAINS=mysite.ma,blog.mysite.ma
